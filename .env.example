# Local dev (npm run dev). For the container use ./scripts/local-up.sh instead.

# MySQL proxy creds (local-up.sh reads them from ~/.secrets)
IM_DB_PROXY_URL=https://your-proxy/dbproxy/
IM_DB_PROXY_AUTH="Basic base64(user:pass)"

# Host LLM bridge: node llm-bridge/server.mjs (same token on both sides)
LLM_BRIDGE_URL=http://127.0.0.1:8787
LLM_BRIDGE_TOKEN=change-me
# claude | codex | antigravity
LLM_DEFAULT_PROVIDER=claude

PORT=3000

# Optional, otherwise generated into sessions/.encryption-key
# SESSION_ENCRYPTION_KEY="64-character-hex-key"
