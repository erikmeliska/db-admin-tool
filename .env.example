# Local dev (npm run dev). The desktop app needs none of this.

# MySQL proxy creds; if unset, read from ~/.secrets (or $SECRETS_FILE)
# IM_DB_PROXY_URL=https://your-proxy/dbproxy/
# IM_DB_PROXY_AUTH="Basic base64(user:pass)"

# AI: local CLI used when the browser sends none: claude | codex | antigravity
LLM_DEFAULT_PROVIDER=claude

PORT=3000

# Where encrypted sessions live (default ./sessions)
# SESSIONS_DIR=./sessions
# Optional, otherwise generated into $SESSIONS_DIR/.encryption-key
# SESSION_ENCRYPTION_KEY="64-character-hex-key"
